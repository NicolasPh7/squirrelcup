<gazebo>
      <plugin name="ignition::gazebo::systems::MecanumDrive" filename="libignition-gazebo-mecanum-drive-system.so">
        <back_left_joint>back_left_joint</back_left_joint>
        <front_left_joint>front_left_joint</front_left_joint>
        <front_right_joint>front_right_joint</front_right_joint>
        <back_right_joint>back_right_joint</back_right_joint>
        <wheel_separation>0.25</wheel_separation>
        <wheelbase>0.25</wheelbase>
        <wheel_radius>0.05</wheel_radius>
        <odom_publish_frequency>20</odom_publish_frequency>      
        <odom_topic>odom</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
        <topic>cmd_vel</topic>
        <publish_odom>false</publish_odom>


        <publishWheelTF>true</publishWheelTF>
        <publishWheelJointState>true</publishWheelJointState>
        <WheelTorque>1</WheelTorque>
        <wheelAccel>5</wheelAccel>
        <isRollerModel>true</isRollerModel>
      </plugin>
</gazebo>



</robot>
