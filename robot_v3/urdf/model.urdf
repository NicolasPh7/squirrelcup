  <gazebo>
  <plugin
      filename="libignition-gazebo-mecanum-drive-system.so"
      name="ignition::gazebo::systems::MecanumDrive">
      <front_left_joint>wheel_joint_4</front_left_joint>
      <front_right_joint>wheel_joint_3</front_right_joint>
      <back_left_joint>wheel_joint_2</back_left_joint>
      <back_right_joint>wheel_joint_1</back_right_joint>

      <wheel_separation>0.153</wheel_separation>  <!-- dist wheel left to right -->
      <wheelbase>0.207</wheelbase> <!-- dist wheel front to back -->
      <wheel_radius>0.05</wheel_radius>

      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/odometry</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <tf_topic>/tf</tf_topic>

      <topic>cmd_vel</topic>
      <publish_odom>true</publish_odom>

        <publishWheelTF>true</publishWheelTF>
        <publishWheelJointState>true</publishWheelJointState>
        <WheelTorque>1</WheelTorque>
        <wheelAccel>5</wheelAccel>
        <isRollerModel>true</isRollerModel>
      </plugin>

    <plugin
      filename="ignition-gazebo-sensors-system"
      name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <plugin
      filename="libignition-gazebo-joint-position-controller-system.so"
      name="ignition::gazebo::systems::JointPositionController">
      <joint_name>joint_1</joint_name>
      <topic>/joint_1/position_cmd</topic>
      <p_gain>100</p_gain>
      <i_gain>0.1</i_gain>
      <d_gain>0.01</d_gain>
      <i_max>1</i_max>
      <i_min>-1</i_min>
      <cmd_max>1000</cmd_max>
      <cmd_min>-1000</cmd_min>
    </plugin>
    <plugin
      filename="libignition-gazebo-joint-position-controller-system.so"
