<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="yellow_crate">
    <static>false</static>
    <link name="link">
      <inertial>
        <mass>0.17</mass>
        <inertia>
          <ixx>0.166</ixx>
          <iyy>0.166</iyy>
          <izz>0.166</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.15 0.05 0.03</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- Seitenflächen: grau -->
      <visual name="side_faces">
        <geometry>
          <box>
            <size>0.15 0.05 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
        </material>
      </visual>

      <!-- Oberseite: blau -->
      <visual name="top_face">
        <pose>0 0 0.0151 0 0 0</pose>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>0.15 0.05</size>
          </plane>
        </geometry>
        <material>
          <diffuse>0.969 0.710 0.0 1</diffuse>
        </material>
      </visual>

      <!-- Unterseite: blau -->
      <visual name="bottom_face">
        <pose>0 0 -0.0151 0 0 0</pose>
        <geometry>
          <plane>
            <normal>0 0 -1</normal>
            <size>0.15 0.05</size>
          </plane>
        </geometry>
        <material>
          <diffuse>0.969 0.710 0.0 1</diffuse>
        </material>
      </visual>

      <!-- ArUco Marker oben -->
      <visual name="marker_border">
        <pose>0 0 0.016 0 0 0</pose>
      <geometry>
        <box>
          <size>0.05 0.05 0.0004</size>
        </box>
      </geometry>
      <material>
        <diffuse>1 1 1 1</diffuse> <!-- Weiß -->
      </material>
    </visual>
      <visual name="aruco_marker">
        <pose>0 0 0.0162 0 0 0</pose>
        <geometry>
          <box>
            <size>0.04 0.04 0.0005</size> 
          </box>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>file://models/yellow_crate/aruco_47.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>0.8</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <visual name="marker_border_down">
        <pose>0 0 -0.016 0 0 0</pose>
      <geometry>
        <box>
          <size>0.05 0.05 0.0004</size>
        </box>
      </geometry>
      <material>
        <diffuse>1 1 1 1</diffuse> <!-- Weiß -->
      </material>
    </visual>
      <visual name="aruco_marker_down">
        <pose>0 0 -0.0162 3.141 0 0</pose>
        <geometry>
          <box>
            <size>0.04 0.04 0.0005</size> 
          </box>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>file://models/yellow_crate/aruco_47.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>0.8</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

    </link>
  </model>
</sdf>
