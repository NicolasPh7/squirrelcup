	<plugin
		filename="libignition-gazebo-mecanum-drive-system.so"
		name="ignition::gazebo::systems::MecanumDrive">
		<back_right_joint>wheel_joint_1</back_right_joint>
		<front_right_joint>wheel_joint_2</front_right_joint>
		<front_left_joint>wheel_joint_3</front_left_joint>
		<back_left_joint>wheel_joint_4</back_left_joint>

		<wheelbase>0.20681</wheelbase> <!-- dist wheel front to back -->
		<wheel_separation>0.189</wheel_separation>  <!-- dist wheel left to right -->
		<wheel_radius>0.04</wheel_radius>

		<odom_publish_frequency>50</odom_publish_frequency>
		<publish_odom>true</publish_odom>
		<odom_topic>/odometry</odom_topic>
		<tf_topic>/tf</tf_topic>
		<frame_id>odom</frame_id>
		<child_frame_id>base_link</child_frame_id>

		<topic>cmd_vel</topic>
	</plugin>

	<plugin
		filename="ignition-gazebo-sensors-system"
		name="ignition::gazebo::systems::Sensors">
		<render_engine>ogre</render_engine>
	</plugin>

