import cv2
import numpy as np
from ultralytics import YOLO
import tkinter as tk
from tkinter import ttk, messagebox

# --- PART 1: TARGET SELECTION VIA GRAPHICAL INTERFACE ---

def get_target_from_user(class_names):
    target_class = [None]

    def on_validate():
        chosen_class = combo.get()
        if chosen_class in class_names:
            target_class[0] = chosen_class
            root.destroy()
        else:
            messagebox.showerror("Error", "Please select a valid object from the list.")

    root = tk.Tk()
    root.title("Robot Configuration")
    root.geometry("350x120")

    label = tk.Label(root, text="Which object do you want to target?")
    label.pack(pady=10)

    combo = ttk.Combobox(root, values=class_names)
    combo.pack(pady=5)
    combo.set("e.g., bottle")

    root.bind('<Return>', lambda event: on_validate())

    validate_button = tk.Button(root, text="Start Detection", command=on_validate)
    validate_button.pack(pady=10)

    root.mainloop()
    return target_class[0]

# --- PART 2: DETECTION AND VISUALIZATION LOGIC ---

try:
    model = YOLO('yolov8n-seg.pt')
    VALID_CLASSES = sorted(list(model.names.values()))
except Exception as e:
    print(f"Critical error: Unable to load YOLO model. {e}")
    exit()

TARGET_CLASS_NAME = get_target_from_user(VALID_CLASSES)

if not TARGET_CLASS_NAME:
    print("No target selected. Exiting program.")
    exit()

CONFIDENCE_THRESHOLD = 0.7
cap = cv2.VideoCapture(0)
if not cap.isOpened():
    print("❌ Unable to access the camera.")
    exit()

print(f"✅ Model loaded. Targeting '{TARGET_CLASS_NAME}'. Press 'q' to quit.")

while True:
    ret, frame = cap.read()
    if not ret:
        break

    tunnel_vision_view = np.zeros(frame.shape, dtype=np.uint8)
    results = model(frame, verbose=False)

    for result in results:
        if result.masks is not None:
            for i, mask_data in enumerate(result.masks.data):
                confidence = result.boxes.conf[i].item()
                class_id = int(result.boxes.cls[i].item())
                class_name = model.names[class_id]

                if class_name == TARGET_CLASS_NAME and confidence > CONFIDENCE_THRESHOLD:
                    contour = result.masks.xy[i].astype(int)
                    
                    stencil = np.zeros(frame.shape[:2], dtype=np.uint8)
                    
                    # FIX HERE: use (255, 255, 255) tuple for white
                    cv2.fillPoly(stencil, [contour], (255, 255, 255))
                    
                    isolated_object = cv2.bitwise_and(frame, frame, mask=stencil)
                    tunnel_vision_view = cv2.add(tunnel_vision_view, isolated_object)

    combined_view = np.hstack((tunnel_vision_view, frame))
    cv2.imshow(f"Robot Vision | Left: Brain (target: {TARGET_CLASS_NAME}) | Right: Camera View", combined_view)

    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()

"""
